  "scripts": {
    "dev": "vite",
    "build": "node --test tests/*.test.mjs && node --test tests/memorization-interface.test.mjs && node --test tests/memorization-database.test.mjs && pnpm test:runtime && tsc --noEmit && vite build && git diff --check",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:runtime": "vitest --config vitest.config.ts run tests/memorization-runtime-behavior.test.tsx tests/memorization-workspace-rpc.test.ts tests/app-version.test.ts tests/members-runtime.test.tsx tests/teacher-invitations-runtime.test.tsx",
    "test:teacher-invitations:function": "deno test --config supabase/functions/invite-teacher/deno.json supabase/functions/invite-teacher/index.test.ts",
    "test:teacher-invitations:migration": "bash tests/run-teacher-invitations-migration-test.sh",
    "test:memorization-teacher-rpc:migration": "bash tests/run-memorization-teacher-rpc-migration-test.sh"
  },
